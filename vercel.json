{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/iyzico-reconcile",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/media/learning/:path*",
      "destination": "https://fibexawaayvejcqoofqu.supabase.co/storage/v1/object/public/myunilab/:path*"
    }
  ],
  "headers": [
    {
      "source": "/media/learning/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=2592000, stale-while-revalidate=86400"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
